{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiangge.local/schemas/keyword-package-2.0.json",
  "title": "Amazon Keyword Package 2.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "package_id", "package_version", "package_hash",
    "run_id", "run_mode", "marketplace", "product_id", "source_mode",
    "source_line_policy", "data_sources", "mcp", "records", "listing_pools",
    "pools", "negative_records", "negative_pools", "asin_records", "asin_pools",
    "compliance", "conservation", "analysis", "handoff", "downstream_eligibility",
    "data_explanation_window", "late_data_revision", "acceptance_checks"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "package_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "integer", "minimum": 1},
    "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["package_id", "package_version", "package_hash"],
          "properties": {
            "package_id": {"type": "string", "minLength": 1},
            "package_version": {"type": "integer", "minimum": 1},
            "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "run_id": {"type": "string", "minLength": 1},
    "run_mode": {"enum": ["production", "demo_direct_run"]},
    "demo_label": {"type": ["string", "null"]},
    "marketplace": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "source_mode": {"enum": ["sif", "sellersprite", "xiyou"]},
    "source_line_policy": {"const": "isolated"},
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataSource"}
    },
    "mcp": {"$ref": "#/$defs/mcpLog"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/keywordRecord"}
    },
    "listing_pools": {"$ref": "#/$defs/idPools"},
    "pools": {"$ref": "#/$defs/idPools"},
    "negative_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/negativeRecord"}
    },
    "negative_pools": {"$ref": "#/$defs/idPools"},
    "asin_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/asinRecord"}
    },
    "asin_pools": {"$ref": "#/$defs/idPools"},
    "conservation": {
      "type": "object",
      "required": [
        "raw_rows", "blank_keyword_rows", "invalid_rows", "normalized_valid_rows",
        "unique_keywords", "merged_duplicate_rows", "disposition_counts", "records_count"
      ],
      "properties": {
        "raw_rows": {"type": "integer", "minimum": 0},
        "blank_keyword_rows": {"type": "integer", "minimum": 0},
        "invalid_rows": {"type": "integer", "minimum": 0},
        "normalized_valid_rows": {"type": "integer", "minimum": 0},
        "unique_keywords": {"type": "integer", "minimum": 0},
        "merged_duplicate_rows": {"type": "integer", "minimum": 0},
        "records_count": {"type": "integer", "minimum": 0},
        "disposition_counts": {
          "type": "object",
          "required": ["retained", "observe", "brand_isolated", "compliance_negative", "low_relevance_negative"],
          "properties": {
            "retained": {"type": "integer", "minimum": 0},
            "observe": {"type": "integer", "minimum": 0},
            "brand_isolated": {"type": "integer", "minimum": 0},
            "compliance_negative": {"type": "integer", "minimum": 0},
            "low_relevance_negative": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "data_explanation_window": {
      "type": "object",
      "required": ["obtained_facts", "derived", "simulated", "missing_and_impact", "continue_and_revision"]
    },
    "late_data_revision": {
      "type": "object",
      "required": [
        "policy", "changed_source_ids", "changed_record_ids", "changed_fields",
        "affected_artifacts", "unaffected_artifacts", "invalidates_downstream_hashes"
      ],
      "properties": {
        "policy": {"const": "impact_scoped"},
        "invalidates_downstream_hashes": {"const": true}
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "required": ["start", "end", "month"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "month": {"type": ["string", "null"], "pattern": "^(20[0-9]{2}-(0[1-9]|1[0-2]))?$"},
        "timezone": {"type": ["string", "null"]}
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id", "provider", "acquisition_method", "marketplace", "as_of",
        "period", "units", "field_mapping", "missing_fields"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "provider": {"enum": ["sif", "sellersprite", "xiyou"]},
        "acquisition_method": {"enum": ["file", "mcp"]},
        "relative_path": {"type": ["string", "null"]},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "marketplace": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "minLength": 1},
        "period": {"$ref": "#/$defs/period"},
        "units": {"type": "object"},
        "field_mapping": {"type": "object"},
        "missing_fields": {"type": "array"}
      }
    },
    "mcpLog": {
      "type": "object",
      "required": ["status", "calls"],
      "properties": {
        "status": {"enum": ["used", "partial", "skipped", "failed"]},
        "skipped_reason": {"type": ["string", "null"]},
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool_name", "called_at", "parameters_summary", "result_status", "returned_count"],
            "properties": {
              "tool_name": {"type": "string", "minLength": 1},
              "called_at": {"type": "string", "minLength": 1},
              "parameters_summary": {"type": "string"},
              "result_status": {"enum": ["success", "partial", "failed"]},
              "returned_count": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["value", "status", "source_id", "semantic", "period"],
      "properties": {
        "value": {"type": ["number", "integer", "string", "null"]},
        "status": {"enum": ["provided", "derived", "proxy", "missing", "invalid", "not_observed_zero_rank", "not_applicable"]},
        "missing_reason": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "semantic": {"type": "string", "minLength": 1},
        "period": {"$ref": "#/$defs/period"}
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "confirmed_competitor_count", "competitor_coverage_count", "competitor_asins",
        "coverage_ratio", "export_observed_asins"
      ],
      "properties": {
        "confirmed_competitor_count": {"type": "integer", "minimum": 0},
        "competitor_coverage_count": {"type": "integer", "minimum": 0},
        "competitor_asins": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "coverage_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "coverage_missing_reason": {"type": ["string", "null"]},
        "export_observed_asins": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "semantic"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "semantic": {"type": "string", "minLength": 1}
      }
    },
    "keywordRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "keyword_id", "keyword", "normalized_keyword", "disposition", "claim_restricted",
        "labels", "six_dimensions", "metrics", "coverage", "listing_eligibility",
        "ad_eligibility", "lineage"
      ],
      "properties": {
        "keyword_id": {"type": "string", "minLength": 1},
        "keyword": {"type": "string", "minLength": 1},
        "normalized_keyword": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": ["retained", "observe", "brand_isolated", "compliance_negative", "low_relevance_negative"]
        },
        "claim_restricted": {"type": "boolean"},
        "labels": {"type": "array"},
        "six_dimensions": {
          "type": "object",
          "required": ["D1", "D2", "D3", "D4", "D5", "D6"]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/metric"}
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}
      }
    },
    "negativeRecord": {
      "type": "object",
      "required": ["negative_id", "expression", "match_type", "reason", "lineage"],
      "properties": {
        "negative_id": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "match_type": {"enum": ["exact", "phrase"]},
        "reason": {"type": "string", "minLength": 1},
        "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}
      }
    },
    "asinRecord": {
      "type": "object",
      "required": ["asin_id", "asin", "labels", "metrics", "lineage"],
      "properties": {
        "asin_id": {"type": "string", "minLength": 1},
        "asin": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
        "labels": {"type": "array"},
        "metrics": {"type": "object"},
        "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}
      }
    },
    "idPools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true
      }
    }
  }
}
